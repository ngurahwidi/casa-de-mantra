APP_NAME="Casa de Mantra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,sentry_logs
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=casa_de_mantra
DB_USERNAME=sail
DB_PASSWORD=password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Error tracking (T12.4). An empty DSN sends nothing (CI, or local when you don't want events).
# Production sets the DSN and SENTRY_RELEASE (the deployed git commit), and leaves out
# SENTRY_TRACES_SAMPLE_RATE so the default 10% applies; locally every request is traced.
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Backups (T12.4, spatie/laravel-backup). BACKUP_DISKS is a comma separated list of disks from
# config/filesystems.php, e.g. "backups,s3" to keep an off-site copy. Failures are emailed.
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# Health checks (T12.4, config/monitoring.php).
MONITORING_MIN_FREE_DISK_PERCENT=10
MONITORING_QUEUE_MAX_WAIT_MINUTES=15

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Initial property profile (PropertyProfileSeeder). Edit later from the admin panel.
PROPERTY_TYPE=villa
PROPERTY_NAME="Demo Villa"
PROPERTY_TIMEZONE=Asia/Makassar
PROPERTY_CURRENCY=IDR
PROPERTY_CHECKIN_TIME=14:00
PROPERTY_CHECKOUT_TIME=12:00
PROPERTY_WHATSAPP=
PROPERTY_EMAIL=
PROPERTY_ADDRESS=
PROPERTY_LAT=
PROPERTY_LNG=
PROPERTY_PAYMENT_WINDOW_HOURS=24
PROPERTY_PENDING_REMINDER_HOURS=12

# How long the scheduled prune jobs keep old data (config/retention.php).
RETENTION_NOTIFICATION_LOG_DAYS=365
RETENTION_OUTBOX_EVENT_DAYS=90
RETENTION_TEMPORARY_UPLOAD_HOURS=24

VITE_APP_NAME="${APP_NAME}"
